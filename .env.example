# Copie este arquivo para .env.local (que NÃO vai para o git) e ajuste. Reinicie o npm run dev após mudar.

# "true" força a análise e o chat pelas regras locais, sem IA e sem custo. Sem chave, as regras entram sozinhas.
DIALYS_MODO_DEMO=false

# Chave da API do Claude (console.anthropic.com > API Keys). Cada pessoa usa a sua; nunca faça commit dela.
ANTHROPIC_API_KEY=

# 32+ caracteres aleatórios para assinar a sessão (sem ela, as sessões caem ao reiniciar o servidor).
DIALYS_SESSAO_SEGREDO=

# Fuso da agenda (padrão America/Sao_Paulo).
# DIALYS_FUSO_HORARIO=America/Sao_Paulo
