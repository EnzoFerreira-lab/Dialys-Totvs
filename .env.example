# Copie este arquivo para .env.local (que NÃO vai para o git) e ajuste. Reinicie o npm run dev após mudar.

# "true" força a análise e o chat pelas regras locais, sem IA e sem custo. Sem chave, as regras entram sozinhas.
DIALYS_MODO_DEMO=false

# Análise das reuniões e assistente Dialys com o NVIDIA Nemotron gratuito via OpenRouter (openrouter.ai > Keys; não precisa de créditos).
# Com esta chave, o Nemotron substitui a IA simulada. Cada pessoa usa a sua; nunca faça commit dela.
OPENROUTER_API_KEY=
# Opcional: outro modelo (padrão nvidia/nemotron-3-super-120b-a12b:free) ou outra API compatível com a da OpenAI,
# ex.: a da NVIDIA (https://integrate.api.nvidia.com/v1, com NVIDIA_API_KEY no lugar da chave do OpenRouter).
# DIALYS_NEMOTRON_MODELO=nvidia/nemotron-3-super-120b-a12b:free
# DIALYS_NEMOTRON_URL=https://openrouter.ai/api/v1
# Raciocínio antes de responder: off (padrão, ~3 s por reunião), low, medium ou high (bem mais lento: 2+ min).
# DIALYS_NEMOTRON_RACIOCINIO=off

# Chave da API do Claude (console.anthropic.com > API Keys). Usada na análise e no assistente só se não houver
# chave do Nemotron.
ANTHROPIC_API_KEY=

# 32+ caracteres aleatórios para assinar a sessão (sem ela, as sessões caem ao reiniciar o servidor).
DIALYS_SESSAO_SEGREDO=

# Fuso da agenda (padrão America/Sao_Paulo).
# DIALYS_FUSO_HORARIO=America/Sao_Paulo
